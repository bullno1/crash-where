{
  "name": "collector",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "login": "sh scripts/login.sh",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "cloudflare": {
    "bindings": {
      "ACCESS_TEAM_DOMAIN": {
        "description": "Your Zero Trust team domain. e.g: `<team>.cloudflareaccess.com`."
      },
      "ACCESS_AUD": {
        "description": "The Application Audience (AUD) Tag of the Access application that protects the dashboard hostname, from the application overview in Zero Trust."
      }
    }
  }
}
