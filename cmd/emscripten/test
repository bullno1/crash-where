#!/bin/sh
# Runs cw_test in every browser named by CW_TEST_BROWSERS, a space
# separated list of chromium, firefox and safari, each optionally as
# <name>=<command>. Unset, every one of them found on PATH; safari by
# its driver, safaridriver, which must have been enabled once.
#
# Leaves out the tests listed in test/web/skip, unless CW_TEST_SKIP is
# set, even to nothing. A test named on the command line always runs.
#
# CW_TEST_WEB_TRANSPORT=xhr makes the transport send the way it does in a
# browser that cannot suspend. A run of everything adds the http suite
# that way by itself.
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
. "$HERE/../env.sh"

: "${CW_TEST_SKIP=$(sed 's/#.*//' "$ROOT/test/web/skip" | tr '\n' ' ')}"
# A synchronous request follows redirects, so this one cannot pass with it.
XHR_SKIP="$CW_TEST_SKIP http/redirect_is_not_followed"
if [ "${CW_TEST_WEB_TRANSPORT:-}" = xhr ]; then
	CW_TEST_SKIP=$XHR_SKIP
fi
export CW_TEST_SKIP

"$HERE/build"
mkdir -p "$BUILD_DIR/test/work"
cd "$BUILD_DIR/test"

if [ -z "${CW_TEST_BROWSERS:-}" ]; then
	CW_TEST_BROWSERS=
	for browser in chromium chromium-browser google-chrome google-chrome-stable; do
		if command -v "$browser" >/dev/null 2>&1; then
			CW_TEST_BROWSERS="chromium=$browser"
			break
		fi
	done
	if command -v firefox >/dev/null 2>&1; then
		CW_TEST_BROWSERS="$CW_TEST_BROWSERS firefox"
	fi
	if command -v safaridriver >/dev/null 2>&1; then
		CW_TEST_BROWSERS="$CW_TEST_BROWSERS safari"
	fi
fi
if [ -z "$(echo "$CW_TEST_BROWSERS" | tr -d ' ')" ]; then
	echo "no browser found; install chromium or firefox, or set CW_TEST_BROWSERS" >&2
	exit 1
fi

status=0
for browser in $CW_TEST_BROWSERS; do
	name=${browser%%=*}
	echo "==== $name ===="
	node "$ROOT/test/web/launch.js" \
		--bin "$BIN_DIR" --work "$BUILD_DIR/test/work/$name" --browser "$browser" \
		"$@" || status=$?
	if [ $# -eq 0 ] && [ -z "${CW_TEST_WEB_TRANSPORT:-}" ]; then
		echo "==== $name, synchronous transport ===="
		CW_TEST_WEB_TRANSPORT=xhr CW_TEST_SKIP=$XHR_SKIP node "$ROOT/test/web/launch.js" \
			--bin "$BIN_DIR" --work "$BUILD_DIR/test/work/$name" --browser "$browser" \
			http || status=$?
	fi
done
exit $status
