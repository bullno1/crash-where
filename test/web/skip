# Tests cmd/emscripten/test leaves out, one `suite/test` per line.
#
# Each group names the first thing in the way, not the only one. Remove a
# line when its test passes; everything not listed runs. To run the lot:
#   CW_TEST_SKIP= cmd/emscripten/test

# Frames are checked against addresses the child records about itself. A
# Wasm function can read neither its return address nor where it sits in
# the file.
crash/null_write
crash/null_write_leaf

# The report directory of one child is kept for the next. A child's store
# lives in its watcher's memory and ends with it.
consent/summary_counts_waiting_reports
consent/once_releases_waiting_reports
consent/once_sticks_to_released_reports
consent/never_purges_and_stops_reporting
consent/always_persists
drain/backlog_drains_after_auth
drain/backlog_drains_at_exit_without_auth
drain/stale_report_is_deleted

# Needs a second thread.
crash/thread_stack_overflow
crash/thread_null_write

# Stack exhaustion is an error type the shim does not take.
crash/stack_overflow

# Expects the report of a game that ended without cw_shutdown(). Game and
# watcher end together on the web.
crash/exit_without_shutdown

# A page cannot be put under a debugger from inside, nor tell that it is
# under one.
crash/debugger
crash/debugger_forced

# Hangs are not detected on the web.
hang/stall_then_exit
hang/stall_then_crash
hang/stopped

# The host backend records nothing.
host/collects_standard_keys

# Reads fixtures, or this executable, from the host's files.
table/golden
cli/usage
cli/dump_matches_golden
cli/convert
cli/convert_debug_file
cli/lookup
cli/symbolize
cli/upload
cli/upload_reports_refusal
cli/upload_refuses_prefix
