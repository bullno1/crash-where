# Tests cmd/emscripten/test leaves out, one `suite/test` per line.
#
# Each group names the first thing in the way, not the only one. Remove a
# line when its test passes; everything not listed runs. To run the lot:
#   CW_TEST_SKIP= cmd/emscripten/test

# Frames are checked against addresses the child records about itself. A
# Wasm function can read neither its return address nor where it sits in
# the file.
crash/null_write
crash/null_write_leaf
crash/thread_null_write

# Expects the report of a game that ended without cw_shutdown(). Game and
# watcher end together on the web.
crash/exit_without_shutdown
consent/summary_counts_waiting_reports

# Expects an abort that no handler reported. On the web abort() traps
# whatever signal() was told, so the crash is reported with frames.
crash/cw_abort_unhandled

# A page cannot be put under a debugger from inside, nor tell that it is
# under one.
crash/debugger
crash/debugger_forced

# Hangs are not detected on the web.
hang/stall_then_exit
hang/stall_then_crash
hang/stopped

# Converts this executable. A page has no file for it.
cli/convert_debug_file
